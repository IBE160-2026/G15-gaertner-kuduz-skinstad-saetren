# Gjelder bare OpenRouter: sett ekte nøkkel bare i .env, som er gitignorert.
# Backend leser ikke .env. TURNUSHJELPEREN_-variablene under settes i terminalen.
OPENROUTER_API_KEY=
# Appens standardmodell er openai/gpt-6-luna (valgt 2026-10-16). Testverktøyet
# scripts/modelltest_openrouter.py bruker anthropic/claude-haiku-5.5 når feltet er tomt,
# slik de loggførte kjøringene gjorde. Godkjente modeller: se MODELS i skriptet.
# --model på kommandolinjen har forrang.
OPENROUTER_MODEL=

# Sti til SQLite-databasen. Leses fra miljøet; backend leser ikke .env selv.
# Relativ sti tolkes fra arbeidsmappen. Tom eller manglende verdi gir
# backend/turnushjelperen.db, uavhengig av hvor kommandoen kjøres fra.
TURNUSHJELPEREN_DB=

# Valgfritt. Personlig passord for turnusansvarlig (kari.vestby), brukt av
# testdatakommandoen. Backend leser ikke .env: variabelen må settes i terminalen
# før `python -m adaptere.lagring.testdata` kjøres. Tom eller manglende verdi gir
# et tilfeldig testpassord som skrives ut i terminalen. Se README.
TURNUSHJELPEREN_PASSORD=

# Valgfritt. Hvor mange minutter en innlogging varer (positivt heltall). Backend
# leser ikke .env: variabelen må settes i terminalen før uvicorn startes. Tom eller
# manglende verdi gir 480 minutter. En ugyldig verdi gjør at API-et ikke starter.
TURNUSHJELPEREN_JWT_MINUTTER=
